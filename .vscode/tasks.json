{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "make -j$(nproc) GCC_PATH=${env:HOME}/.local/opt/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "generate (CubeMX + patch)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "cubemx"
      ],
      "problemMatcher": []
    },
    {
      "label": "cubemx",
      "type": "shell",
      "command": "bash tools/generate.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "flash",
      "type": "shell",
      "command": "${env:HOME}/.local/opt/xpack-openocd-0.12.0-7/bin/openocd -f interface/stlink.cfg -f target/stm32f4x.cfg -c \"program build/igh6_jxb.elf verify reset exit\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "erase",
      "type": "shell",
      "command": "${env:HOME}/.local/opt/xpack-openocd-0.12.0-7/bin/openocd -f interface/stlink.cfg -f target/stm32f4x.cfg -c \"init; reset halt; stm32f4x mass_erase 0; exit\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

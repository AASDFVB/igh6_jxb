{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake --preset Debug",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build build/Debug -j$(nproc)",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "rm -rf build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "flash",
      "type": "shell",
      "command": "${env:HOME}/.local/opt/xpack-openocd-0.12.0-7/bin/openocd -f interface/stlink.cfg -f target/stm32f4x.cfg -c \"program build/Debug/igh6_jxb.elf verify reset exit\"",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["build"],
      "problemMatcher": []
    },
    {
      "label": "erase",
      "type": "shell",
      "command": "${env:HOME}/.local/opt/xpack-openocd-0.12.0-7/bin/openocd -f interface/stlink.cfg -f target/stm32f4x.cfg -c \"init; reset halt; stm32f4x mass_erase 0; exit\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}

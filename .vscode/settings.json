{
  "C_Cpp.intelliSenseEngine": "default",
  "files.associations": {
    "*.h": "c",
    "*.ioc": "ini",
    "Makefile": "makefile"
  },
  "search.exclude": {
    "build": true,
    "Drivers": true,
    "Middlewares": true
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
